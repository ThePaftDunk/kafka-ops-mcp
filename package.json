{
  "name": "kafka-ops-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Read-only, allowlisted Kafka diagnostics for MCP clients",
  "type": "module",
  "engines": {"node": ">=20"},
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
