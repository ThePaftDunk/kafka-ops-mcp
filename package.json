    "demo": "npm run build && node dist/demo.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "kafkajs": "2.2.4",
    "zod": "3.25.76"
  },
  "devDependencies": {"@types/node": "22.10.2", "typescript": "5.9.3"}
}
